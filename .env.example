# ==============================================================================
# CampusWhisper Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.

# Server Configuration (Render injects PORT automatically)
PORT=8080
SERVER_PORT=8080

# PostgreSQL Database Configuration
# Option A: Full Connection URL (e.g., from Supabase or Render)
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:5432/postgres

# Option B: Individual Database Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whisper
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:password@host:port

# JWT Authentication (HS256 Base64 Secret & Expiry in Milliseconds)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# JPA & Hibernate Settings
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Allowed CORS Origins (comma-separated, supports wildcards for Render)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.onrender.com
